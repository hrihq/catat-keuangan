<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating Action Button (design: yellow squircle, dark plus) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="96dp"
        android:minWidth="0dp"
        android:contentDescription="@string/fab_add"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="?attr/colorTertiaryContainer"
        app:cornerRadius="20dp"
        app:elevation="6dp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?attr/colorOnTertiaryContainer" />

    <!-- Floating pill bottom navigation -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="32dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Beranda -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/tab_home"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/navLabelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_home"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Statistik -->
            <LinearLayout
                android:id="@+id/tabStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconStats"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/tab_stats"
                    android:src="@drawable/ic_pie_chart" />

                <TextView
                    android:id="@+id/navLabelStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_stats"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Dompet -->
            <LinearLayout
                android:id="@+id/tabWallet"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconWallet"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/tab_wallet"
                    android:src="@drawable/ic_wallet" />

                <TextView
                    android:id="@+id/navLabelWallet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_wallet"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Profil -->
            <LinearLayout
                android:id="@+id/tabProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconProfile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/tab_profile"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/navLabelProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_profile"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
